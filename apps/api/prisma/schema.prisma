// BizPilot data model.
//
// Money: every monetary column is a BigInt holding the amount in the currency's
// minor unit (1/100). Integer arithmetic keeps sums exact and BigInt gives us
// the range RWF needs — a plain Int tops out around 21M RWF, which a hardware
// store would blow through in a month. Convert at the DTO boundary only.
//
// Tenancy: every business-owned row carries `businessId` and every query goes
// through TenantScope. There is no global "admin sees everything" path in the
// app API; platform admin lives behind a separate module.
//
// Naming: tables are snake_case (via @@map) but columns keep Prisma's camelCase
// field names. Postgres folds unquoted identifiers to lower case, so any raw
// SQL must double-quote column names — `SUM("costTotal")`, not `SUM(cost_total)`.
// Unquoted works for single-word columns (total, amount, status) and breaks
// silently for the rest, so quote them all in raw queries.

generator client {
  provider = "prisma-client-js"
}

// Two URLs, because a serverless Postgres (Neon) puts a connection pooler in
// front of the database:
//
//   url       — the pooled endpoint. Everything the running app does goes here.
//               The compute scales to zero when idle and the pooler handles
//               waking it and reconnecting.
//   directUrl — a direct connection, bypassing the pooler. `prisma migrate`
//               takes advisory locks, and those do not survive transaction-mode
//               pooling: run migrations through the pooler and they fail with a
//               lock error that reads like a network problem.
//
// On a plain Postgres with no pooler — local Docker, or Render's built-in
// database — set both to the same value.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum BusinessType {
  SHOP
  PHARMACY
  RESTAURANT
  HARDWARE
  SALON
  OTHER
}

enum PlanId {
  free
  starter
  business
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Business {
  id            String       @id @default(uuid())
  name          String
  type          BusinessType @default(SHOP)
  /// ISO 4217 code. Drives formatting and the currency we charge in.
  currency      String       @default("RWF")
  /// ISO 3166-1 alpha-2, used to pick payment channels (MoMo vs card).
  country       String       @default("RW")
  timezone      String       @default("Africa/Kigali")
  phone         String?
  email         String?
  address       String?
  logoUrl       String?
  /// Printed on invoices, e.g. a TIN.
  taxId         String?
  /// Percentage in basis points (1800 = 18% VAT). Applied when a sale opts in.
  defaultTaxBps Int          @default(0)
  /// Invoice numbering, e.g. "INV-0042".
  invoicePrefix String       @default("INV")
  receiptPrefix String       @default("RCP")

  plan               PlanId             @default(free)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users           User[]
  locations       Location[]
  products        Product[]
  customers       Customer[]
  sales           Sale[]
  invoices        Invoice[]
  expenses        Expense[]
  payments        Payment[]
  stockMovements  StockMovement[]
  subscription    Subscription?
  smsMessages     SmsMessage[]
  aiConversations AiConversation[]
  usageCounters   UsageCounter[]
  auditLogs       AuditLog[]

  @@index([deletedAt])
  @@map("businesses")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
}

model User {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  sales               Sale[]
  expenses            Expense[]
  stockMovements      StockMovement[]
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]

  /// Email is unique globally: it is the login identifier, so one address maps
  /// to exactly one account. Staff at two businesses need two addresses.
  @@unique([email])
  @@index([businessId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The raw value only ever exists in the client.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A forgot-password token. Single-use and short-lived: thirty minutes is
/// enough to walk to a computer and click a link, and short enough that a
/// mailbox someone left open on a shared shop computer is not a standing
/// backdoor into the account.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token, same rule as refresh tokens: the raw value only
  /// ever exists in the email.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A branch or outlet. Every business gets a default location at signup;
/// additional locations are gated behind the Business plan.
model Location {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  sales          Sale[]
  expenses       Expense[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Catalogue & stock
// ---------------------------------------------------------------------------

model Product {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  sku         String?
  barcode     String?
  category    String?
  description String?
  /// Free-text unit label: "piece", "kg", "box", "plate".
  unit        String  @default("piece")

  /// What you pay for one unit, in minor units. Drives profit maths.
  costPrice BigInt @default(0)
  /// What you charge for one unit, in minor units.
  sellPrice BigInt @default(0)

  /// Current quantity on hand across the whole business.
  stockQty     Int     @default(0)
  /// Alert threshold — at or below this, the product shows as low stock.
  reorderLevel Int     @default(0)
  /// Services (a haircut, a repair) have no stock to deplete.
  trackStock   Boolean @default(true)

  imageUrl String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  saleItems      SaleItem[]
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@unique([businessId, sku])
  @@index([businessId, isActive])
  @@index([businessId, name])
  @@index([businessId, barcode])
  @@map("products")
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
}

/// Append-only ledger of every stock change. `stockQty` on Product is the
/// running total; this table is why it has that value.
model StockMovement {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  type         StockMovementType
  /// Signed: positive adds stock, negative removes it.
  quantity     Int
  /// Stock on hand immediately after this movement, for audit trails.
  balanceAfter Int
  /// Unit cost for PURCHASE movements, used for cost-price averaging.
  unitCost     BigInt?
  note         String?
  /// Sale id, invoice id or supplier reference that caused the movement.
  reference    String?

  createdAt DateTime @default(now())

  @@index([businessId, productId, createdAt])
  @@index([businessId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Customers, sales & invoices
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String
  phone   String?
  email   String?
  address String?
  note    String?
  /// Outstanding credit owed to the business, in minor units.
  balance BigInt  @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales       Sale[]
  invoices    Invoice[]
  payments    Payment[]
  smsMessages SmsMessage[]

  @@index([businessId, name])
  @@index([businessId, phone])
  @@map("customers")
}

enum PaymentMethod {
  CASH
  MOMO
  CARD
  BANK
  CREDIT
}

enum SaleStatus {
  COMPLETED
  PARTIAL
  VOIDED
}

model Sale {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Human-facing receipt number, unique per business.
  number String

  /// Sum of line totals before discount and tax.
  subtotal   BigInt
  /// Absolute discount applied to the whole sale.
  discount   BigInt @default(0)
  /// Tax charged, in minor units.
  tax        BigInt @default(0)
  /// subtotal - discount + tax
  total      BigInt
  /// Sum of cost prices at time of sale — snapshotted so later price changes
  /// do not rewrite historical profit.
  costTotal  BigInt @default(0)
  /// How much the customer has actually handed over so far.
  amountPaid BigInt @default(0)

  paymentMethod PaymentMethod @default(CASH)
  status        SaleStatus    @default(COMPLETED)
  note          String?

  /// When the sale happened — backdating is allowed, so this is not createdAt.
  soldAt    DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  voidedAt  DateTime?

  items    SaleItem[]
  payments Payment[]
  invoice  Invoice?

  @@unique([businessId, number])
  @@index([businessId, soldAt])
  @@index([businessId, status])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Nullable so deleting a product never destroys sales history.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Snapshot of the product name at sale time.
  name      String
  quantity  Int
  unitPrice BigInt
  /// Cost price at the moment of sale, for accurate historical margin.
  unitCost  BigInt @default(0)
  discount  BigInt @default(0)
  /// quantity * unitPrice - discount
  total     BigInt

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

model Invoice {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Set when the invoice was generated from a completed sale.
  saleId     String?   @unique
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  number String
  status InvoiceStatus @default(DRAFT)

  subtotal   BigInt
  discount   BigInt @default(0)
  tax        BigInt @default(0)
  total      BigInt
  amountPaid BigInt @default(0)

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?
  terms     String?

  /// Opaque token for the public /pay/:token page — lets a customer view and
  /// pay without an account. Rotated if the owner revokes the link.
  publicToken String @unique @default(uuid())

  sentAt         DateTime?
  paidAt         DateTime?
  /// Last time a reminder SMS went out, so we do not spam daily.
  lastReminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InvoiceItem[]
  payments    Payment[]
  smsMessages SmsMessage[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name        String
  description String?
  quantity    Int
  unitPrice   BigInt
  discount    BigInt  @default(0)
  total       BigInt

  @@index([invoiceId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------------
// Money in and money out
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

/// A payment received from a customer. Subscription payments the business
/// makes to BizPilot live in BillingTransaction instead.
model Payment {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  amount   BigInt
  currency String        @default("RWF")
  method   PaymentMethod @default(CASH)
  status   PaymentStatus @default(SUCCESSFUL)

  /// Gateway identifier, e.g. "flutterwave". Null for cash taken at the counter.
  provider     String?
  /// Our reference, sent to the gateway as tx_ref. Unique so webhook replays
  /// cannot double-credit an invoice.
  reference    String? @unique
  /// The gateway's own transaction id, returned on verification.
  providerRef  String?
  /// Raw verification payload, kept for dispute resolution.
  providerMeta Json?

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Free text so a shop can use its own vocabulary: "rent", "transport",
  /// "airtime", "stock purchase".
  category   String
  amount     BigInt
  note       String?
  vendor     String?
  method     PaymentMethod @default(CASH)
  receiptUrl String?

  spentAt   DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessId, spentAt])
  @@index([businessId, category])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Billing (what businesses pay us)
// ---------------------------------------------------------------------------

model Subscription {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan   PlanId             @default(free)
  status SubscriptionStatus @default(TRIALING)

  /// "flutterwave" once a paid plan is active.
  provider       String?
  /// Flutterwave payment-plan id, when using their recurring billing.
  providerPlanId String?
  /// Flutterwave subscription id, for cancellation.
  providerRef    String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// Set when the owner cancels: access continues until currentPeriodEnd.
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BillingTransaction[]

  @@map("subscriptions")
}

model BillingTransaction {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  plan     PlanId
  amount   BigInt
  currency String        @default("RWF")
  status   PaymentStatus @default(PENDING)

  provider     String  @default("flutterwave")
  /// tx_ref we generated. Unique — the webhook is idempotent on this.
  reference    String  @unique
  providerRef  String?
  providerMeta Json?

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, createdAt])
  @@map("billing_transactions")
}

/// Per-month counters for plan limits. One row per business per metric per
/// period, incremented atomically so we never need to COUNT(*) a huge table
/// on every write.
model UsageCounter {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// "sales", "sms", "ai_messages"
  metric     String
  /// First day of the month this counter covers, at UTC midnight.
  period     DateTime
  count      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, metric, period])
  @@map("usage_counters")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model SmsMessage {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// E.164, e.g. +250788123456.
  to     String
  body   String
  status SmsStatus @default(QUEUED)
  /// "invoice_reminder", "payment_received", "manual", "low_stock"
  kind   String    @default("manual")

  provider    String?
  providerRef String?
  error       String?
  /// Cost charged by the SMS gateway, in minor units, for margin tracking.
  cost        BigInt?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([businessId, createdAt])
  @@index([status])
  @@map("sms_messages")
}

// ---------------------------------------------------------------------------
// AI assistant
// ---------------------------------------------------------------------------

model AiConversation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([businessId, updatedAt])
  @@map("ai_conversations")
}

enum AiRole {
  user
  assistant
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role         AiRole
  content      String
  /// Names of the data tools the assistant ran to answer, for transparency.
  toolsUsed    String[] @default([])
  /// Token counts, for cost attribution per business.
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// "sale.void", "product.delete", "user.invite", "subscription.upgrade"
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_logs")
}
