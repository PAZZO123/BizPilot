# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Public URL of the React app, used to build invoice payment links.
WEB_URL=http://localhost:5173
# Public URL of this API, used for gateway webhook/redirect callbacks.
API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://bizpilot:bizpilot@localhost:5434/bizpilot?schema=public
# Used only by `prisma migrate`, which needs a connection that bypasses any
# pooler. Local Postgres has no pooler, so it is the same URL. On Neon these are
# two different strings — the pooled one has "-pooler" in the host.
DIRECT_URL=postgresql://bizpilot:bizpilot@localhost:5434/bizpilot?schema=public
REDIS_URL=redis://localhost:6380

# --- Assistant ---------------------------------------------------------------
# Leave AI_PROVIDER unset to use Anthropic (ANTHROPIC_API_KEY below).
# To run on a free tier while the product has no revenue, uncomment these four.
# Any provider serving OpenAI's /chat/completions with tool calling works.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=

# ---------------------------------------------------------------------------
# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Platform dashboard — BizPilot's own revenue, and every shop's usage.
#
# Comma-separated emails. Empty means nobody, which is the safe default: this
# is deliberately not a database flag, so nobody can grant it from inside the
# product and a compromised owner account cannot escalate into it.
# ---------------------------------------------------------------------------
PLATFORM_ADMIN_EMAILS=
# What the AI provider charges, in whole RWF per million tokens. Defaults are
# claude-opus-5 ($5 in / $25 out) at ~1,450 RWF/USD. The dashboard prices the
# assistant line from real recorded token counts at these rates.
AI_INPUT_RWF_PER_MTOK=7250
AI_OUTPUT_RWF_PER_MTOK=36250
# Fallback for replies with no recorded usage (rows from before metering), in
# RWF minor units (1500 = 15 RWF).
AI_COST_PER_MESSAGE_RWF=1500

# ---------------------------------------------------------------------------
# AI assistant (https://console.anthropic.com)
# Leave blank to run without AI — the assistant returns a clear "not configured"
# message instead of crashing.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# claude-opus-5 is the most capable model. claude-sonnet-5 costs less per token
# if the AI assistant turns out to be your biggest variable cost.
ANTHROPIC_MODEL=claude-opus-5
# Reasoning depth: low | medium | high | xhigh | max. "low" is a good fit here —
# the assistant reads small structured tool results and answers plainly.
ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------------------
# Payments. Provider is one of: mtn-momo | flutterwave
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mtn-momo

# --- MTN MoMo (https://momodeveloper.mtn.com) --------------------------------
# Sandbox is free and self-service; production needs MTN's approval. In the
# sandbox MTN settles EUR only — the app knows and allows for this.
# NEVER commit the real values of these; they go in .env / Render only.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# sandbox | production — must match where the credentials were issued.
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Host MTN calls back on payment completion. Must equal the providerCallbackHost
# the API user was registered with, or MTN rejects the request.
MOMO_CALLBACK_HOST=
# Long random string embedded in the callback URL path — MoMo callbacks are
# unsigned, so the secret in the path is what authenticates them.
MOMO_CALLBACK_SECRET=

# --- Flutterwave (https://dashboard.flutterwave.com/settings/apis) -----------
# Use the TEST keys until you are live.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "Secret hash" you set in Flutterwave → Settings → Webhooks. Every webhook
# request must present it in the verif-hash header or we reject it.
FLUTTERWAVE_WEBHOOK_HASH=

# ---------------------------------------------------------------------------
# SMS. Provider is one of: log | africastalking | twilio
# `log` writes messages to the console and marks them sent — use it in dev.
# ---------------------------------------------------------------------------
SMS_PROVIDER=log
SMS_SENDER_ID=BizPilot
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Email. Provider is one of: log | resend
# Only password-reset links today. `log` prints the mail (link included) to the
# server log — the whole flow works in dev with no account anywhere.
# Resend's free tier is 100 emails/day; until you verify a sending domain
# there, use MAIL_FROM=onboarding@resend.dev (delivers only to your own inbox).
# ---------------------------------------------------------------------------
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=BizPilot <onboarding@resend.dev>
